<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>collect_interfaces</name>
  <version>0.1.0</version>
  <description>
    데이터 수집(joystick_colormarker.py)과 웹 대시보드 사이의 설정/결과
    서비스 정의. 배치·목표색 설정(/collect/set_config)과 에피소드 결과
    제출(/collect/submit_result)에 쓰인다.
  </description>
  <maintainer email="soda@serbot.local">soda</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
